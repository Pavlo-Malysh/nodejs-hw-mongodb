      "delete": {
        "tags": [
          "Contact"
        ],
        "summary": "delete contact by id",
        "operationId": "DeleteContact",
        "description": "Delete contact by id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "68efd41636a23320bb4ef586"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully found contact with id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
